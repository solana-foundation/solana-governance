# Sentry vars
NEXT_PUBLIC_SENTRY_DSN="<your Sentry DSN>"
SENTRY_AUTH_TOKEN="<token for source map uploads>"


# Solana RPC endpoints (server-side; never prefix these with NEXT_PUBLIC_)
SOLANA_RPC_URL_MAINNET="https://mainnet.helius-rpc.com/?api-key=<your-api-key>"
SOLANA_RPC_URL_TESTNET="https://api.testnet.solana.com"
SOLANA_RPC_URL_DEVNET="https://api.devnet.solana.com"
